{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "row",
      "title": "Status Geral",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "title": "Health Status",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "OFFLINE", "color": "semi-dark-red" }, "1": { "text": "ONLINE", "color": "semi-dark-green" } } }], "thresholds": { "mode": "absolute", "steps": [{ "color": "semi-dark-red", "value": null }, { "color": "semi-dark-green", "value": 1 }] } } },
      "options": { "colorMode": "background_solid", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "up{job=\"batalha-naval\"}", "legendFormat": "Backend" }]
    },
    {
      "title": "Requisições Lentas (>500ms)",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "semi-dark-green", "value": null }, { "color": "#EAB839", "value": 5 }, { "color": "red", "value": 10 }] } } },
      "options": { "colorMode": "background_solid", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "http_server_requests_slow_total{application=\"batalha-naval\"}", "legendFormat": "Total" }]
    },
    {
      "title": "Partidas Ativas",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 20 }, { "color": "red", "value": 50 }] } } },
      "options": { "colorMode": "background_solid", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "sum(partidas_ativas)", "legendFormat": "Total" }]
    },
    {
      "title": "CPU Usage",
      "type": "gauge",
      "datasource": "Prometheus",
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.5 }, { "color": "dark-red", "value": 0.8 }] } } },
      "options": { "showThresholdMarkers": true, "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "process_cpu_usage", "legendFormat": "__auto" }]
    },
    {
      "title": "Partidas Criadas",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 5 },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } } },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "sum(partidas_criadas_total)", "legendFormat": "Total" }]
    },
    {
      "title": "Requisições Bloqueadas",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 5 },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 50 }, { "color": "red", "value": 200 }] } } },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "rate_limit_blocked_total", "legendFormat": "Bloqueadas" }]
    },
    {
      "title": "Cache Hit Rate (%)",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "percent", "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 50 }, { "color": "green", "value": 80 }] } } },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "sum(cache_gets_total{result=\"hit\"}) / clamp_min(sum(cache_gets_total{result=~\"hit|miss\"}), 1) * 100", "legendFormat": "Hit Rate" }]
    },
    {
      "type": "row",
      "title": "Performance",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "collapsed": false,
      "panels": []
    },
    {
      "title": "Threads Ativas",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 10 },
      "fieldConfig": { "defaults": { "color": { "fixedColor": "dark-blue", "mode": "fixed" }, "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "lineWidth": 2, "fillOpacity": 15, "gradientMode": "opacity", "showPoints": "never" }, "decimals": 0, "min": 0 } },
      "targets": [{ "expr": "jvm_threads_live_threads{application=\"batalha-naval\"}", "legendFormat": "Live Threads" }]
    },
    {
      "title": "Uso de CPU",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 10 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 20, "gradientMode": "scheme", "showPoints": "auto" }, "unit": "percentunit", "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "#EAB839", "value": 0.5 }, { "color": "red", "value": 0.8 }] } } },
      "targets": [{ "expr": "process_cpu_usage", "legendFormat": "CPU" }]
    },
    {
      "title": "Requisições por Segundo",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "color": { "mode": "continuous-GrYlRd" }, "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 0, "gradientMode": "scheme", "showPoints": "never" }, "unit": "reqps", "min": 0, "decimals": 1 } },
      "options": { "legend": { "calcs": ["last", "max"], "displayMode": "table", "placement": "bottom" } },
      "targets": [{ "expr": "sum by (uri) (rate(http_server_requests_seconds_count{application=\"batalha-naval\", uri=~\"/api/game.*|/api/auth.*|/api/quiz.*\"}[1m]))", "legendFormat": "{{uri}}" }]
    },
    {
      "title": "Requisições Bloqueadas (Rate Limit)/min",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "color": { "fixedColor": "orange", "mode": "fixed" }, "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 20, "showPoints": "never" }, "min": 0 } },
      "targets": [{ "expr": "sum(rate(http_server_requests_seconds_count{status=\"429\", application=\"batalha-naval\"}[1m])) * 60", "legendFormat": "429/min" }]
    },
    {
      "type": "row",
      "title": "Aplicação",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "collapsed": false,
      "panels": []
    },
    {
      "title": "Partidas Ativas por Modo",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 60, "gradientMode": "none", "showPoints": "never", "stacking": { "mode": "normal" } }, "min": 0 } },
      "options": { "legend": { "calcs": ["last"], "displayMode": "table", "placement": "bottom" } },
      "targets": [{ "expr": "partidas_ativas", "legendFormat": "{{modo}}" }]
    },
    {
      "title": "JVM Heap Used",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 1, "fillOpacity": 30, "gradientMode": "opacity", "showPoints": "never", "stacking": { "mode": "normal" } }, "unit": "decbytes", "min": 0 } },
      "options": { "legend": { "calcs": ["last", "max"], "displayMode": "table", "placement": "bottom" } },
      "targets": [{ "expr": "jvm_memory_used_bytes{area=\"heap\", application=\"batalha-naval\"}", "legendFormat": "{{id}}" }]
    },
    {
      "title": "Tiros - Clássico",
      "type": "piechart",
      "datasource": "Prometheus",
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 31 },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "pieType": "donut" },
      "targets": [{ "expr": "gameplay_tiros_total{modo=\"classico\"}", "legendFormat": "{{resultado}}" }]
    },
    {
      "title": "Tiros - Minado",
      "type": "piechart",
      "datasource": "Prometheus",
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 31 },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "pieType": "donut" },
      "targets": [{ "expr": "gameplay_tiros_total{modo=\"minado\"}", "legendFormat": "{{resultado}}" }]
    },
    {
      "title": "Quiz - Respostas",
      "type": "piechart",
      "datasource": "Prometheus",
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 31 },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "pieType": "donut" },
      "targets": [{ "expr": "gameplay_quiz_respostas_total", "legendFormat": "{{resultado}}" }]
    },
    {
      "title": "Quiz - Acertos por Dificuldade (%)",
      "type": "bargauge",
      "datasource": "Prometheus",
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 31 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 40 }, { "color": "green", "value": 70 }] } } },
      "options": { "orientation": "horizontal", "displayMode": "gradient", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "sum(gameplay_quiz_por_dificuldade_total{dificuldade=\"easy\",resultado=\"correta\"}) / clamp_min(sum(gameplay_quiz_por_dificuldade_total{dificuldade=\"easy\"}), 1) * 100", "legendFormat": "Fácil", "refId": "A" },
        { "expr": "sum(gameplay_quiz_por_dificuldade_total{dificuldade=\"medium\",resultado=\"correta\"}) / clamp_min(sum(gameplay_quiz_por_dificuldade_total{dificuldade=\"medium\"}), 1) * 100", "legendFormat": "Média", "refId": "B" },
        { "expr": "sum(gameplay_quiz_por_dificuldade_total{dificuldade=\"hard\",resultado=\"correta\"}) / clamp_min(sum(gameplay_quiz_por_dificuldade_total{dificuldade=\"hard\"}), 1) * 100", "legendFormat": "Difícil", "refId": "C" }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["batalha-naval"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "Batalha Naval - Observabilidade",
  "uid": "batalha-naval-dash",
  "version": 5
}
